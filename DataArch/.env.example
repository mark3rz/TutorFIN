# ──────────────────────────────────────────────────────────────
# DataArch.AI — Environment Variables
#
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# Anthropic API key — needed for document extraction & AI features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ─────────────────────────────────────────────────
# Docker Compose (local dev) sets DATABASE_URL automatically from the vars below.
POSTGRES_USER=dataarch
POSTGRES_PASSWORD=dataarch
POSTGRES_DB=dataarch

# ── Production Database ───────────────────────────────────────
# For production deployments, override DATABASE_URL with your managed Postgres.
# The local `db` service in docker-compose.yml is NOT used when DATABASE_URL
# points to an external host — use docker-compose.prod.yml which omits it.
#
# Supabase (recommended — free tier, pgvector included):
#   DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# AWS RDS (pgvector must be enabled manually via CREATE EXTENSION):
#   DATABASE_URL=postgresql://dataarch:password@xxxx.rds.amazonaws.com:5432/dataarch?sslmode=require
#
# SSL mode (prefer=default, require=production, disable=never in prod):
# DB_SSL_MODE=require
#
# Production pool settings (adjust for managed DB connection limits):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ── Optional: AI Features ────────────────────────────────────
# Voyage AI key — enables vector embeddings for semantic search
# Get one at https://dash.voyageai.com/
# VOYAGE_API_KEY=pa-your-voyage-key-here

# ── Optional: Configuration ──────────────────────────────────
# DATAARCH_MODEL=claude-sonnet-4-5-20250929
# DATAARCH_ENV=dev
# API_PORT=8000
# DB_PORT=5432

# ── Storage Backend ───────────────────────────────────────────
# STORAGE_BACKEND=local          # default — Docker named volume
# STORAGE_BACKEND=s3             # use S3 for multi-instance / cloud deployments
# S3_BUCKET=dataarch-outputs
# S3_PREFIX=v1/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Invitations ───────────────────────────────────────────────
# OPEN_REGISTRATION=true         # set to false once invite flow is active
# INVITE_EXPIRY_DAYS=7
# RESEND_API_KEY=re_...          # get one at https://resend.com (free tier)
# FROM_EMAIL=noreply@dataarch.ai
# APP_URL=https://yourdomain.com
