# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files (download fresh via script)
data/raw/*.csv
data/processed/*.npz
data/processed/*.csv

# Model artifacts (retrain via script)
models/trained/*.pt
models/trained/*.joblib
models/trained/*.json
models/preprocessors/*.joblib

# Generated outputs
outputs/figures/*.png
outputs/tables/*.csv
outputs/traces/*.json
outputs/reports/*.json

# Metadata (regenerated by pipeline)
data/metadata/*.json
data/metadata/*.csv

# Jupyter checkpoints
.ipynb_checkpoints/

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
!models/trained/.gitkeep
!models/preprocessors/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/traces/.gitkeep
!outputs/reports/.gitkeep
